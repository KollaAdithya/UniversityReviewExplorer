# Teammate setup: copy this file locally — never commit infra/gcp.env (gitignored).
#
#   git clone https://github.com/KollaAdithya/UniversityReviewExplorer.git
#   cd UniversityReviewExplorer
#   cp infra/gcp.env.example infra/gcp.env
#   # edit infra/gcp.env with YOUR project + Firebase keys
#   chmod +x scripts/*.sh && ./scripts/install-gcp-tools.sh
#   set -a && source infra/gcp.env && set +a
#   ./scripts/verify-gcp-prereqs.sh
#   ./scripts/deploy-gcp.sh
#
# IMPORTANT: Do NOT source backend/.env before deploy scripts.
# backend/.env is for local dev only (localhost CORS, Firebase emulator).

GCP_PROJECT=your-gcp-project-id
GCP_REGION=us-central1

# Firebase (Console → Project settings → Your apps → Web)
FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# Optional — auto-set by deploy-gcp.sh after backend deploy
# VITE_API_BASE_URL=https://course-review-api-xxxxx-uc.a.run.app

# Optional — default is https://storage.googleapis.com (required for GCS-hosted frontend)
# CORS_ORIGINS=https://storage.googleapis.com

# Optional — store in Secret Manager for live review NLP + AI summaries on Cloud Run
# echo -n 'YOUR_GROQ_KEY' | gcloud secrets create groq-api-key --data-file=- --project $GCP_PROJECT
# echo -n 'YOUR_OPENAI_KEY' | gcloud secrets create openai-api-key --data-file=- --project $GCP_PROJECT
