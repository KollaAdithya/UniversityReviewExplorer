# Local development defaults (SQLite when Docker/Postgres unavailable)
DATABASE_URL=sqlite:///./course_reviews.db
ENVIRONMENT=local
USE_MOCK_ML=true
ENABLE_BIGQUERY=false
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5174

# Firebase Authentication (local emulator by default)
AUTH_REQUIRED=true
FIREBASE_PROJECT_ID=course-review-explorer-demo
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_CREDENTIALS_PATH=
AUTH_DEV_TOKEN=local-dev-verifier-token

# Optional GCP (Stage 2)
GCP_PROJECT=
GCP_REGION=us-central1
VERTEX_MODEL=gemini-2.0-flash
BIGQUERY_DATASET=course_reviews_dataset
BIGQUERY_TABLE=reviews_analytics
