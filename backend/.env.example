# Copy to backend/.env and fill in secrets locally (never commit .env)
DATABASE_URL=sqlite:///./course_reviews.db
ENVIRONMENT=local
USE_MOCK_ML=true
ML_PROVIDER=groq
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SEC=90
OLLAMA_LIVE_REVIEWS_ONLY=true
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_SEC=60
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SEC=60
ENABLE_BIGQUERY=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174

AUTH_REQUIRED=true
FIREBASE_PROJECT_ID=course-review-explorer-demo
# Local only — leave empty on Cloud Run / production
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_CREDENTIALS_PATH=
AUTH_DEV_TOKEN=local-dev-verifier-token

GCP_PROJECT=
GCP_REGION=us-central1
VERTEX_MODEL=gemini-2.0-flash
BIGQUERY_DATASET=course_reviews_dataset
BIGQUERY_TABLE=reviews_analytics
